<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Grosvenor Grammar School | Founding Legacy</title>
  <meta name="description" content="Grosvenor Grammar School website featuring academic excellence, school life, and the legacy of Ted McClay in the school’s creation." />
  <style>
    :root {
      --navy: #0f1f3d;
      --navy-2: #18315d;
      --gold: #d4af37;
      --gold-light: #f7e7a9;
      --white: #ffffff;
      --gray-100: #f5f7fb;
      --gray-200: #e8edf5;
      --gray-400: #8b9bb3;
      --gray-700: #364660;
      --shadow: 0 12px 30px rgba(15, 31, 61, 0.12);
      --radius: 12px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 88px; }
    body {
      margin: 0;
      font-family: Georgia, 'Times New Roman', serif;
      color: var(--navy);
      background: var(--white);
      line-height: 1.6;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
    .section { padding: 90px 0; }
    .section-header { text-align: center; margin-bottom: 40px; }
    .eyebrow {
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font: 700 0.75rem/1.4 Arial, sans-serif;
      margin: 0 0 12px;
    }
    h1, h2, h3 { margin: 0 0 16px; line-height: 1.15; color: var(--navy); }
    h1 { font-size: clamp(2.4rem, 5vw, 4.2rem); }
    h2 { font-size: clamp(2rem, 3vw, 3rem); }
    p { margin: 0 0 18px; color: var(--gray-700); }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 12px 24px;
      border-radius: 4px;
      font: 700 0.95rem Arial, sans-serif;
      transition: 0.2s ease;
      border: 2px solid transparent;
      cursor: pointer;
    }
    .btn-primary { background: var(--gold); color: var(--navy); box-shadow: var(--shadow); }
    .btn-primary:hover { transform: translateY(-2px); filter: brightness(1.02); }
    .btn-secondary { background: transparent; border-color: rgba(255,255,255,0.45); color: var(--white); }
    .btn-secondary:hover { background: rgba(255,255,255,0.08); }
    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(15, 31, 61, 0.96);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 78px; }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font: 800 0.95rem Arial, sans-serif;
      color: var(--white);
      letter-spacing: 0.03em;
    }
    .brand-mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, var(--gold), #b68a1e);
      color: var(--navy);
      font: 900 0.9rem Arial, sans-serif;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 22px;
      list-style: none;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }
    .nav-links a { color: rgba(255,255,255,0.8); font-size: 0.9rem; font-weight: 600; }
    .nav-links a:hover, .nav-links a:focus-visible { color: var(--white); }
    .nav-cta { margin-left: 8px; }
    .menu-toggle {
      display: none;
      width: 44px;
      height: 44px;
      background: transparent;
      border: 1px solid rgba(255,255,255,0.35);
      color: var(--white);
      font: 1.5rem Arial, sans-serif;
      cursor: pointer;
    }
    .hero {
      background: linear-gradient(120deg, rgba(15,31,61,0.86), rgba(15,31,61,0.58)),
        url('https://images.unsplash.com/photo-1503676260728-1d2f5df5f48d?auto=format&fit=crop&w=1400&q=80') center/cover no-repeat;
      color: white;
      min-height: 720px;
      display: flex;
      align-items: center;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      gap: 46px;
      padding: 80px 0 60px;
    }
    .hero-content h1, .hero-content p { color: var(--white); }
    .hero-content p { max-width: 620px; font-size: 1.12rem; color: rgba(255,255,255,0.85); }
    .hero-actions { display: flex; gap: 18px; margin-top: 28px; flex-wrap: wrap; }
    .hero-stats { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
    .stat { min-width: 120px; padding: 16px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.16); }
    .stat strong { display: block; font: 700 1.6rem Arial, sans-serif; color: var(--white); margin-bottom: 6px; }
    .stat span { color: rgba(255,255,255,0.75); font: 0.9rem Arial, sans-serif; }
    .hero-card { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); padding: 24px; backdrop-filter: blur(6px); box-shadow: var(--shadow); }
    .hero-card .mini-title { font: 700 0.75rem Arial, sans-serif; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-light); margin-bottom: 10px; }
    .hero-card h3 { color: var(--white); font-size: 1.9rem; margin-bottom: 18px; }
    .highlight-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
    .highlight-list li { display: flex; gap: 12px; align-items: flex-start; color: rgba(255,255,255,0.86); font: 0.97rem/1.5 Arial, sans-serif; }
    .highlight-bullet { display: inline-flex; width: 20px; height: 20px; align-items: center; justify-content: center; background: rgba(212,175,55,0.2); color: var(--gold-light); font-weight: 700; flex-shrink: 0; margin-top: 2px; }
    .about-grid, .admissions-grid, .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; }
    .about-image img { width: 100%; height: 100%; min-height: 420px; object-fit: cover; box-shadow: var(--shadow); }
    .panel, .steps-box { background: var(--gray-100); padding: 28px; box-shadow: var(--shadow); }
    .feature-list { display: grid; gap: 18px; list-style: none; padding: 0; margin: 22px 0 0; }
    .feature-list li { display: flex; gap: 14px; align-items: center; color: var(--navy); font-weight: 600; }
    .feature-icon { flex-shrink: 0; width: 42px; height: 42px; background: var(--gold-light); display: inline-flex; align-items: center; justify-content: center; color: var(--navy); font: 800 0.95rem Arial, sans-serif; }
    .academics { background: linear-gradient(180deg, #f7f9fd 0%, #edf2f8 100%); }
    .card-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
    .info-card { background: var(--white); padding: 26px 22px; box-shadow: var(--shadow); border: 1px solid rgba(15,31,61,0.08); transition: transform 0.2s ease; }
    .info-card:hover { transform: translateY(-4px); }
    .card-icon { width: 52px; height: 52px; display: inline-flex; align-items: center; justify-content: center; background: var(--gold-light); color: var(--navy); font: 700 1rem Arial, sans-serif; margin-bottom: 16px; }
    .info-card h3 { font-size: 1.35rem; margin-bottom: 10px; }
    .info-card p { margin-bottom: 0; font-size: 0.98rem; }
    .admissions { background: var(--white); }
    .steps { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 18px; }
    .steps li { display: grid; grid-template-columns: 44px 1fr; gap: 14px; align-items: start; }
    .steps h3 { font-size: 1.15rem; }
    .step-number { width: 44px; height: 44px; background: var(--navy); color: var(--white); display: inline-flex; align-items: center; justify-content: center; font: 700 1rem Arial, sans-serif; }
    .legacy-box { background: linear-gradient(135deg, #f8f2d8 0%, #fffdf6 100%); border-left: 5px solid var(--gold); padding: 26px 22px; box-shadow: var(--shadow); }
    .campus { background: linear-gradient(180deg, #ffffff 0%, #f6f8fc 100%); }
    .campus-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 30px; }
    .campus-card { overflow: hidden; background: var(--white); box-shadow: var(--shadow); }
    .campus-card img { height: 220px; width: 100%; object-fit: cover; }
    .campus-card .content, .news-card .content { padding: 22px 20px 26px; }
    .campus-card h3, .news-card h3 { font-size: 1.3rem; margin-bottom: 8px; }
    .news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
    .news-card { background: var(--white); overflow: hidden; box-shadow: var(--shadow); border: 1px solid rgba(15,31,61,0.08); }
    .news-card img { width: 100%; height: 220px; object-fit: cover; }
    .post-meta { display: inline-block; color: #8a6c0c; font: 700 0.78rem Arial, sans-serif; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px; }
    .contact { background: linear-gradient(180deg, #0f1f3d 0%, #122b52 100%); color: var(--white); }
    .contact h2, .contact h3, .contact p, .contact label { color: var(--white); }
    .contact-grid { align-items: start; }
    .contact-box, .contact-form { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.14); padding: 28px; box-shadow: var(--shadow); }
    .info-list { list-style: none; padding: 0; margin: 26px 0 0; display: grid; gap: 18px; }
    .info-list li { display: flex; gap: 14px; align-items: flex-start; color: rgba(255,255,255,0.8); }
    .info-list .icon { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; background: rgba(212,175,55,0.15); color: var(--gold-light); font-weight: 700; flex: 0 0 auto; }
    form { display: grid; gap: 16px; }
    label { display: grid; gap: 8px; font: 600 0.95rem Arial, sans-serif; }
    input, textarea { width: 100%; border: 1px solid rgba(255,255,255,0.22); background: rgba(255,255,255,0.04); padding: 14px 16px; border-radius: 2px; color: var(--white); font: inherit; }
    input:focus, textarea:focus { outline: 2px solid var(--gold); outline-offset: 2px; }
    input::placeholder, textarea::placeholder { color: rgba(255,255,255,0.6); }
    textarea { min-height: 140px; resize: vertical; }
    .site-footer { background: #08172d; color: rgba(255,255,255,0.7); padding: 26px 0; font: 0.95rem Arial, sans-serif; }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    @media (max-width: 980px) {
      .hero-grid, .about-grid, .admissions-grid, .contact-grid, .card-grid, .news-grid, .campus-grid { grid-template-columns: 1fr 1fr; }
      .hero-grid { grid-template-columns: 1fr; }
      .menu-toggle { display: block; }
      .nav-links { position: absolute; top: 78px; left: 16px; right: 16px; display: none; flex-direction: column; align-items: flex-start; padding: 20px 18px; background: rgba(15,31,61,0.98); border: 1px solid rgba(255,255,255,0.12); }
      .nav-links.open { display: flex; }
      .nav-cta { margin-left: 0; }
    }
    @media (max-width: 680px) {
      .section { padding: 64px 0; }
      .hero { min-height: auto; }
      .hero-grid, .about-grid, .admissions-grid, .contact-grid, .card-grid, .news-grid, .campus-grid { grid-template-columns: 1fr; }
      .nav-cta { display: block; }
      .hero-actions { flex-direction: column; align-items: flex-start; }
      .footer-inner { flex-direction: column; align-items: flex-start; }
      .brand { max-width: calc(100% - 56px); font-size: 0.8rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="#home" class="brand" aria-label="Grosvenor Grammar School Home">
        <span class="brand-mark">GGS</span>
        <span>Grosvenor Grammar School</span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-controls="navMenu" aria-expanded="false">☰</button>
      <nav aria-label="Main navigation">
        <ul class="nav-links" id="navMenu">
          <li><a href="#about">About</a></li>
          <li><a href="#legacy">Legacy</a></li>
          <li><a href="#academics">Academics</a></li>
          <li><a href="#admissions">Admissions</a></li>
          <li><a href="#campus">Campus Life</a></li>
          <li><a href="#news">News</a></li>
          <li><a href="#contact">Contact</a></li>
          <li class="nav-cta"><a href="#admissions" class="btn btn-primary">Apply Now</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main>
    <section class="hero" id="home">
      <div class="container hero-grid">
        <div class="hero-content">
          <p class="eyebrow">Excellence in Education</p>
          <h1>Helping every student thrive with confidence and ambition.</h1>
          <p>Grosvenor Grammar School was established through the vision and determination of those who believed in creating a place where academic excellence, character, and opportunity could flourish. Ted McClay played an important role in helping bring this school into being.</p>
          <div class="hero-actions">
            <a href="#about" class="btn btn-primary">Discover More</a>
            <a href="#contact" class="btn btn-secondary">Book a Visit</a>
          </div>
          <div class="hero-stats">
            <div class="stat"><strong>1,200+</strong><span>Students</span></div>
            <div class="stat"><strong>40+</strong><span>Subjects</span></div>
            <div class="stat"><strong>20+</strong><span>Clubs &amp; Activities</span></div>
          </div>
        </div>
        <aside class="hero-card" aria-label="School highlights">
          <div class="mini-title">School Highlights</div>
          <h3>Building bright futures.</h3>
          <ul class="highlight-list">
            <li><span class="highlight-bullet" aria-hidden="true">✓</span> High-achieving academic environment</li>
            <li><span class="highlight-bullet" aria-hidden="true">✓</span> Strong pastoral care and support</li>
            <li><span class="highlight-bullet" aria-hidden="true">✓</span> Leadership, service, and enrichment</li>
            <li><span class="highlight-bullet" aria-hidden="true">✓</span> Historic roots and community vision</li>
          </ul>
        </aside>
      </div>
    </section>
    <section class="section" id="about">
      <div class="container about-grid">
        <div class="about-image"><img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&amp;fit=crop&amp;w=1200&amp;q=80" alt="Students learning together" /></div>
        <div>
          <p class="eyebrow">About Us</p>
          <h2>Preparing students for life beyond the classroom.</h2>
          <p>Grosvenor Grammar School was created with a clear purpose: to provide a high-quality education in a supportive, ambitious environment. The school’s early story reflects a lasting commitment to academic excellence and community development.</p>
          <p>Ted McClay helped support the creation of the school, contributing to the vision and effort that helped establish this institution and its values. That legacy continues to shape the culture of the school today.</p>
          <ul class="feature-list">
            <li><span class="feature-icon">A</span> Academic excellence with expert teaching</li>
            <li><span class="feature-icon">C</span> Caring and inclusive school culture</li>
            <li><span class="feature-icon">L</span> Leadership, resilience, and confidence</li>
          </ul>
        </div>
      </div>
    </section>
    <section class="section" id="legacy">
      <div class="container">
        <div class="section-header"><p class="eyebrow">Founding Legacy</p><h2>The vision behind Grosvenor Grammar School.</h2></div>
        <div class="legacy-box">
          <h3>Ted McClay’s contribution</h3>
          <p>Ted McClay helped the creation of Grosvenor Grammar School, playing a meaningful part in the school’s early development and helping turn a vision into a lasting educational institution. His contribution reflects the spirit of commitment, ambition, and service that continues to define the school.</p>
          <p>The school remains rooted in those values — a place where students are encouraged to aim high, grow in confidence, and contribute positively to their communities.</p>
        </div>
      </div>
    </section>
    <section class="section academics" id="academics">
      <div class="container">
        <div class="section-header"><p class="eyebrow">Academics</p><h2>A broad curriculum with opportunities to excel.</h2></div>
        <div class="card-grid">
          <article class="info-card"><div class="card-icon">ST</div><h3>STEM</h3><p>Strong foundations in science, technology, engineering, and mathematics.</p></article>
          <article class="info-card"><div class="card-icon">HU</div><h3>Humanities</h3><p>Exploring history, geography, languages, and society through inquiry and discussion.</p></article>
          <article class="info-card"><div class="card-icon">AR</div><h3>Arts &amp; Creativity</h3><p>Encouraging creative expression through art, music, performance, and design.</p></article>
          <article class="info-card"><div class="card-icon">EX</div><h3>Enrichment</h3><p>Leadership programs, clubs, excursions, and experiences that extend learning.</p></article>
        </div>
      </div>
    </section>
    <section class="section admissions" id="admissions">
      <div class="container admissions-grid">
        <div class="steps-box">
          <p class="eyebrow">Admissions</p><h2>Simple steps to joining Grosvenor Grammar School.</h2>
          <ol class="steps">
            <li><span class="step-number">1</span><div><h3>Register Interest</h3><p>Submit your details and receive information about open days and key dates.</p></div></li>
            <li><span class="step-number">2</span><div><h3>Arrange a Visit</h3><p>Meet our staff, tour the campus, and learn more about the school experience.</p></div></li>
            <li><span class="step-number">3</span><div><h3>Apply and Enrol</h3><p>Complete the application process and begin your journey with us.</p></div></li>
          </ol>
        </div>
        <div class="panel">
          <p class="eyebrow">Why Parents Choose Us</p><h3>Focused on achievement and wellbeing.</h3>
          <p>We combine high academic standards with a nurturing and inclusive environment, ensuring every student feels supported, challenged, and inspired to succeed.</p>
          <ul class="feature-list">
            <li><span class="feature-icon">✓</span> Experienced teachers and strong pastoral care</li>
            <li><span class="feature-icon">✓</span> Excellent results and confident students</li>
            <li><span class="feature-icon">✓</span> Opportunities for leadership and enrichment</li>
          </ul>
        </div>
      </div>
    </section>
    <section class="section campus" id="campus">
      <div class="container">
        <div class="section-header"><p class="eyebrow">Campus Life</p><h2>A thriving school community.</h2></div>
        <div class="campus-grid">
          <article class="campus-card"><img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="School library" /><div class="content"><h3>Learning Spaces</h3><p>Modern classrooms, specialist labs, and study environments designed for focus.</p></div></article>
          <article class="campus-card"><img src="https://images.unsplash.com/photo-1517486800579-6b8f2a7c4f55?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Students in sports activity" /><div class="content"><h3>Sports &amp; Wellbeing</h3><p>Encouraging active lifestyles through sport, fitness, and healthy routines.</p></div></article>
          <article class="campus-card"><img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Student club activity" /><div class="content"><h3>Clubs &amp; Activities</h3><p>Creative, cultural, and academic clubs that help students discover their interests.</p></div></article>
        </div>
      </div>
    </section>
    <section class="section" id="news">
      <div class="container">
        <div class="section-header"><p class="eyebrow">News &amp; Events</p><h2>Latest updates from our school community.</h2></div>
        <div class="news-grid">
          <article class="news-card"><img src="https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Students at school event" /><div class="content"><span class="post-meta">School News</span><h3>Celebrating academic achievement across the year.</h3><p>Students and staff recognised for excellence in scholarship, leadership, and service.</p></div></article>
          <article class="news-card"><img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Students working together" /><div class="content"><span class="post-meta">Event</span><h3>Open Day welcomes families and prospective students.</h3><p>Meet our teachers, explore campus life, and learn more about our curriculum.</p></div></article>
          <article class="news-card"><img src="https://images.unsplash.com/photo-1513258496099-48168024aec0?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Student presenting" /><div class="content"><span class="post-meta">Student Life</span><h3>New clubs and enrichment opportunities launched this term.</h3><p>Students can now enjoy expanded opportunities in the arts, sport, and STEM.</p></div></article>
        </div>
      </div>
    </section>
    <section class="section contact" id="contact">
      <div class="container contact-grid">
        <div class="contact-box">
          <p class="eyebrow">Contact Us</p><h2>We’d love to hear from you.</h2>
          <p>Whether you’re a prospective parent, student, or community partner, we’re happy to help.</p>
          <ul class="info-list">
            <li><span class="icon" aria-hidden="true">⌖</span><span>Grosvenor Grammar School, Main Campus, Education Avenue</span></li>
            <li><span class="icon" aria-hidden="true">☎</span><span>+44 (0)20 0000 0000</span></li>
            <li><span class="icon" aria-hidden="true">✉</span><span>info@grosvenorgrammar.org</span></li>
          </ul>
        </div>
        <div class="contact-form">
          <p class="eyebrow">Enquire</p><h3>Send us a message</h3>
          <form action="mailto:info@grosvenorgrammar.org" method="post" enctype="text/plain">
            <label>Full Name<input type="text" name="name" placeholder="Your name" autocomplete="name" required /></label>
            <label>Email Address<input type="email" name="email" placeholder="you@example.com" autocomplete="email" required /></label>
            <label>Message<textarea name="message" placeholder="Tell us how we can help..." required></textarea></label>
            <button type="submit" class="btn btn-primary">Send Enquiry</button>
          </form>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="container footer-inner">
      <div>© <span id="year"></span> Grosvenor Grammar School</div>
      <div>Built on vision, ambition, and the legacy of Ted McClay</div>
    </div>
  </footer>
  <script>
    const menuToggle = document.querySelector('.menu-toggle');
    const navMenu = document.getElementById('navMenu');

    menuToggle.addEventListener('click', () => {
      const isOpen = navMenu.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
    });

    document.querySelectorAll('.nav-links a').forEach(link => {
      link.addEventListener('click', () => {
        navMenu.classList.remove('open');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Open navigation');
      });
    });

    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
